<head>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <div class="header-div">
        <!-- <img class="header-logo" src="images/ZL Shop Header Icon.webp" alt=""> -->
        <a href="/" class="header-text">ZL Shop</a>




        <div class="wrapper-navbar" id="wrapper-navbar">
            <div class="wrapper-navbar-links">
                <div class="close-navbar-div"><button id="close-navbar"><svg xmlns="http://www.w3.org/2000/svg" height="24px"
                            viewBox="0 -960 960 960" width="24px" fill="#FFFFFF">
                            <path
                                d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" />
                        </svg></button></div>

                <a class="products-shortcut" href="/Cart">Cart</a>
                <a class="products-shortcut" href="/login">Login</a>
                <a class="products-shortcut" href="/register">Register</a>
                <a class="products-shortcut" href="/phones">Phones</a>
                <a class="products-shortcut" href="/computers">Computer</a>
                <a class="products-shortcut" href="/admin/products/new">Dashboard</a>
            </div>
        </div>
        <button id="open-navbar"><svg xmlns=" http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960"
                width="24px" fill="#FFFFFF">
                <path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z" />
            </svg>
        </button>




        <div class="shortcuts-div">
            <a class="products-shortcut" href="/Cart">Cart</a>
            <a class="products-shortcut" href="/login">Login</a>
            <a class="products-shortcut" href="/register">Register</a>
            <a class="products-shortcut" href="/phones">Phones</a>
            <a class="products-shortcut" href="/computers">Computer</a>
            <a class="products-shortcut" href="/admin/products/new">Dashboard</a>
        </div>
    </div>
    <script>
        const openNavbarButton = document.getElementById("open-navbar");
        const closeNavbarButton = document.getElementById("close-navbar");
        const wrapperNavbar = document.getElementById("wrapper-navbar");
        const overlay = document.createElement("div")
        overlay.classList.add("close-overlay")
        wrapperNavbar.style.right = "-100%"
        openNavbarButton.addEventListener("click", () => {
            wrapperNavbar.classList.add("show-wrapper")
            overlay.style.backgroundColor = "rgba(0, 0, 0, 0.418)"
            document.body.appendChild(overlay)
        })

        closeNavbarButton.addEventListener("click", closeNavbar)

        overlay.addEventListener("click", closeNavbar)

        function closeNavbar() {
            wrapperNavbar.classList.remove("show-wrapper")
            overlay.remove()
        }

    </script>
</body>