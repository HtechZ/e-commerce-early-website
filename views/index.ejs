<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZL Shop</title>
    <link rel="shortcut icon" href="/images/ZL Shop Fav Icon.webp" type="image/x-icon">
    <style>
        .p {
            cursor: pointer !important;
        }

        #loginForm {
            display: none;
        }
    </style>
</head>

<body>
    <%- include("./partials/header") %>
        <form id="loginForm" class="new-product-form" action="/" method="post">
            <input type="text" name="loginUsername" id="loginUsername" placeholder="Enter your username">
            <button class="submit-btn" type="submit">Login</button>
        </form>
        <div id="main-div" class="main-div">
            <h1 class="main-h1">All Products</h1>
            <div class="products-div">
                <% allProducts.forEach(product=> { %>
                    <div class="product-div">
                        <h3>
                            <%= product.name %>
                        </h3>
                        <p>
                            <%= product.about %>
                        </p>
                        <form action="/cart" method="post">
                            <input type="hidden" name="productName" value="<%= product.name %>">
                            <% if (!user) { %>
                            <button type="submit" id="buyButton" class="buyButton loginRequired" name="buyButton">Buy</button>
                            <% } else { %>
                            <button type="submit" id="buyButton" class="buyButton" name="buyButton">Buy</button>
                            <% } %>
                        </form>
                    </div>
                    <% }) %>
            </div>
        </div>
        <script>
            document.querySelectorAll(".buyButton").forEach(button => {
                button.addEventListener("click", () => {
                    if (button.classList.contains("loginRequired")) {
                        window.location.href("/login")
                        return
                    }
                    button.style.backgroundColor = "red"
                })
            })
        </script>
</body>

</html>