<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZL Shop</title>
    <link rel="shortcut icon" href="/images/ZL Shop Fav Icon.webp" type="image/x-icon">
</head>

<body>
    <%- include("./partials/header") %>
        <div class="main-div">
            <h1 class="main-h1">All Products</h1>
            <div class="products-div">
                <% allProducts.forEach(product => { %>
                    <div class="product-div">
                        <h3><%= product.name %></h3>
                        <p><%= product.about %></p>
                    </div>
                <% }) %>
            </div>
        </div>
</body>

</html>