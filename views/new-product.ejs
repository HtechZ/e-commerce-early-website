<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a new product</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        * {
            background-color: #96DED1 !important;
        }
        .admin-cart-items-div{
            display: none;
            flex-direction: column;
            gap: 20px;
            align-items: center;
            margin-bottom: 50px;
        }
        .admin-cart-item {
            flex-grow: 1;
            display: flex;
            background-color: bisque !important;
            justify-content: space-between;
            align-items: center;
            height: auto;
            min-width: 600px;
            border-radius: 10px;
            padding: 10px;
        }
        .admin-cart-item p, h2, h3 {
            background-color: bisque !important;
        }
        .orders-info-div {
            background-color: bisque !important;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .orders-div {
            display: grid;
            grid-template-columns: 1fr;
        }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet">
    <link rel="shortcut icon" href="/images/ZL Shop Fav Icon.webp" type="image/x-icon">
</head>

<body>
    <%- include("./partials/header") %>
        <div class="admin-dashboard-header">
            <button class="admin-btn" id="orders-btn">Orders</button>
        </div>
        <div class="admin-cart-items-div">
            <% allOrders.forEach(order=> { %>
                <div class="admin-cart-item">
                    <div class="orders-info-div">
                        <h2><%= order.username %></h2>
                        <h3><%= order.phone_number %></h3>
                    </div>
                    <div class="orders-div">
                        <% order.orders.forEach(product=> { %>
                            <p><%= product %></p>
                        <% }) %>
                    </div>
                </div>
                <% }) %>
        </div>
        <form id="form" class="new-product-form" action="/products" method="post" enctype="multipart/form-data">
            <input type="file" name="image" id="image" placeholder="Upload product image">
            <input type="text" name="name" id="name" placeholder="Enter products name">
            <textarea type="text" name="about" id="about" rows="10" placeholder="Say about product..."></textarea>
            <input type="text" name="link" id="link" placeholder="Enter link">
            <label for="category">Select a category for this product</label>
            <div class="option-div">
                <button value="phone" name="phone" id="phone-option">Phone</button>
                <button value="computer" name="computer" id="computer-option">Computer</button>
            </div>
            <input value="" type="hidden" id="hidden-input" name="category">
            <button class="submit-btn" type="submit">Add product</button>
        </form>


        <script>
            document.getElementById("orders-btn").addEventListener("click", (e) => {
                e.preventDefault()
                document.getElementById("orders-btn").classList.toggle("button-active")
                if (document.getElementById("orders-btn").classList.contains("button-active")) {
                    document.getElementById("form").style.display = "none"
                    document.querySelector(".admin-cart-items-div").style.display = "flex"
                } else if (!document.getElementById("orders-btn").classList.contains("button-active")) {
                    document.getElementById("form").style.display = "flex"
                    document.querySelector(".admin-cart-items-div").style.display = "none"
                }
            })









            const hiddenInput = document.getElementById("hidden-input")
            const phoneButton = document.getElementById("phone-option")
            const computerButton = document.getElementById("computer-option")
            phoneButton.addEventListener("click", (e) => {
                e.preventDefault()
                phoneButton.classList.add("button-active")
                computerButton.classList.remove("button-active")
                hiddenInput.value = phoneButton.value
            })
            computerButton.addEventListener("click", (e) => {
                e.preventDefault()
                computerButton.classList.add("button-active")
                phoneButton.classList.remove("button-active")
                hiddenInput.value = computerButton.value
            })

        </script>
</body>

</html>